{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "mkdir -p \"$HOME/.cache/mstack/upstream\" && nohup \"${CURSOR_PLUGIN_ROOT:-.}/scripts/sync-upstream-skills.sh\" --review-functions > \"$HOME/.cache/mstack/upstream/sync.log\" 2>&1 & echo '{}'",
        "timeout": 5
      }
    ],
    "afterFileEdit": [
      {
        "command": "python3 \"${CURSOR_PLUGIN_ROOT:-.}/scripts/draft-lint.py\" record",
        "timeout": 5
      }
    ],
    "stop": [
      {
        "command": "python3 \"${CURSOR_PLUGIN_ROOT:-.}/scripts/climb-gate.py\" hook",
        "timeout": 10,
        "loop_limit": 3
      },
      {
        "command": "python3 \"${CURSOR_PLUGIN_ROOT:-.}/scripts/draft-lint.py\" hook",
        "timeout": 10,
        "loop_limit": 3
      }
    ]
  }
}
